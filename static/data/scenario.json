  "chapters": [
    {
      "id": "opening",
      "entries": [
        {
          "kind": "dialogue",
          "speaker": "???",
          "speakerId": "chroko",
          "sourceText": "夢見るままに、過去を体験したいと思ったことはありませんか？",
          "background": "dark"
        },
        {
          "kind": "dialogue",
          "speaker": null,
          "sourceText": "目を覚ますと、そこは音楽塔、第1音楽室だった",
          "background": "dark"
        },
        {
          "kind": "dialogue",
          "speaker": null,
          "sourceText": "並んだ椅子。譜面台。窓から差し込む光。少し乾いた部屋の匂いまで、記憶のどこかに残っている",
          "pages": [
            "並んだ椅子。譜面台。窓から差し込む光。",
            "少し乾いた部屋の匂いまで、記憶のどこかに残っている"
          ],
          "background": "dark"
        },
        {
          "kind": "dialogue",
          "speaker": null,
          "sourceText": "誰もいないはずなのに、つい、いつもの席を探してしまう。楽器を持った仲間が、今にも扉を開けて入ってきそうだった",
          "pages": [
            "誰もいないはずなのに、つい、いつもの席を探してしまう。",
            "楽器を持った仲間が、今にも扉を開けて入ってきそうだった"
          ],
          "background": "dark"
        },
        {
          "kind": "dialogue",
          "speaker": null,
          "sourceText": "まもなく基礎練が始まるのだろうか",
          "background": "dark"
        },
        {
          "kind": "dialogue",
          "speaker": null,
          "sourceText": "チクタク、チクタク、メトロノームが時を刻んでいる。その音だけが、あの頃と今をつないでいた",
          "pages": [
            "チクタク、チクタク、メトロノームが時を刻んでいる。",
            "その音だけが、あの頃と今をつないでいた"
          ],
          "background": "light",
          "enterEffects": ["water-transition"]
        },
        {
          "kind": "dialogue",
          "speaker": "???",
          "speakerId": "chroko",
          "sourceText": "懐かしい舞台を用意しました、いつまでもここに居続けるように",
          "background": "light"
        }
      ],
      "completion": {
        "kind": "song-card",
        "number": "1曲目",
        "title": "基礎練・ダイジェスト",
        "cardVariant": "first",
        "advanceMode": "timer",
        "durationMs": 5000,
        "transition": "dark-song-interlude",
        "darkenDurationMs": 1500,
        "fadeOutAudio": "metronome",
        "nextChapter": "after-first-song"
      }
    },
    {
      "id": "after-first-song",
      "entries": [
        {
          "kind": "protagonist",
          "sourceText": "懐かしい……。毎日聴いていた音なのに、あの頃は懐かしくなる日が来るなんて考えてもいなかったな",
          "lines": [
            "懐かしい……。毎日聴いていた音なのに、",
            "あの頃は懐かしくなる日が来るなんて考えてもいなかったな"
          ],
          "background": "music-room"
        },
        {
          "kind": "dialogue",
          "speaker": "???",
          "speakerId": "chroko",
          "sourceText": "幸福度の上昇を確認しました。再現は成功です",
          "background": "music-room"
        },
        {
          "kind": "protagonist",
          "sourceText": "やっぱり誰かいた。さっきから話しているあなたは誰？",
          "lines": [
            "やっぱり誰かいた。",
            "さっきから話しているあなたは誰？"
          ],
          "background": "music-room",
          "character": "default",
          "selectEffects": ["start-corridor-bgm"]
        },
        {
          "kind": "dialogue",
          "speaker": "???",
          "speakerId": "chroko",
          "sourceText": "私は未来から来た人工知能です。人間の記憶と感情を分析し、その人が幸せだった時間を再現できます",
          "background": "music-room",
          "character": "default"
        },
        {
          "kind": "protagonist",
          "sourceText": "未来の人工知能が、最初に見せるのが基礎練なんだ",
          "lines": ["未来の人工知能が、最初に見せるのが基礎練なんだ"],
          "background": "music-room",
          "character": "default"
        },
        {
          "kind": "dialogue",
          "speaker": "???",
          "speakerId": "chroko",
          "sourceText": "基礎練を侮ってはいけません。あなたはチューニングの時点ですでに嬉しそうでした",
          "background": "music-room",
          "character": "smirk"
        },
        {
          "kind": "protagonist",
          "sourceText": "そこまで見られていたの？　ちょっと恥ずかしいな",
          "lines": ["そこまで見られていたの？　ちょっと恥ずかしいな"],
          "background": "music-room",
          "character": "smirk"
        },
        {
          "kind": "dialogue",
          "speaker": "???",
          "speakerId": "chroko",
          "sourceText": "ご安心ください。誰にも言いません",
          "background": "music-room",
          "character": "smile"
        },
        {
          "kind": "protagonist",
          "sourceText": "今、会場のみんなに聞こえたけどね。あなたに名前はあるの？",
          "lines": [
            "今、会場のみんなに聞こえたけどね。",
            "あなたに名前はあるの？"
          ],
          "background": "music-room",
          "character": "smile"
        },
        {
          "kind": "dialogue",
          "speaker": "???",
          "speakerId": "chroko",
          "sourceText": "個体名はありません。呼び名が必要でしたら、あなたに設定をお願いします",
          "background": "music-room",
          "character": "default"
        },
        {
          "kind": "protagonist",
          "sourceText": "急に責任が重い。うーん……じゃあ、クロコ",
          "linePages": [
            ["急に責任が重い。"],
            ["うーん……"],
            ["じゃあ、クロコ"]
          ],
          "background": "music-room",
          "character": "default"
        },
        {
          "kind": "dialogue",
          "speaker": "???",
          "speakerId": "chroko",
          "sourceText": "クロコ。登録しました。",
          "background": "music-room",
          "character": "default",
          "completeEffects": ["register-name"]
        },
        {
          "kind": "dialogue",
          "speaker": "クロコ",
          "speakerId": "chroko",
          "sourceText": "なかなか愛嬌のある名前です",
          "background": "music-room",
          "character": "grin"
        },
        {
          "kind": "protagonist",
          "sourceText": "自分で言うんだ",
          "lines": ["自分で言うんだ"],
          "background": "music-room",
          "character": "grin"
        },
        {
          "kind": "dialogue",
          "speaker": "クロコ",
          "speakerId": "chroko",
          "sourceText": "事実ですから。ではクロコとして、次の舞台へご案内します。今度は、あなたたちが毎年作っていた物語の時間です",
          "background": "music-room",
          "character": "grin"
        }
      ],
      "completion": {
        "kind": "song-card",
        "number": "2曲目",
        "title": "過去の音楽劇メドレー",
        "cardVariant": "second",
        "advanceMode": "timer",
        "durationMs": 5000,
        "transition": "dark-song-interlude",
        "darkenDurationMs": 1500,
        "fadeOutAudio": "corridor",
